www.shepaw.com, shepaw.com {
	root * /var/www/shepaw
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# curl | bash 和 irm | iex 都要拿到纯文本。
	@installer path /install /install.ps1
	handle @installer {
		header {
			defer
			Content-Type "text/plain; charset=utf-8"
		}
		file_server
	}

	handle {
		try_files {path} {path}/ {path}.html
		file_server
	}
}

# ---------------------------------------------------------------------------
# release.shepaw.com — 更新清单与安装包（纯静态，无动态后端）
#
# 目录结构（root = /var/www/shepaw-release，请求路径与磁盘路径一一对应）：
#   /var/www/shepaw-release/api/v1/latest-macos.json              App：macOS
#   /var/www/shepaw-release/api/v1/latest-android.json            App：Android
#   /var/www/shepaw-release/api/v1/latest-ios.json                App：iOS
#   /var/www/shepaw-release/api/v1/latest-windows.json            App：Windows
#   /var/www/shepaw-release/api/v1/latest-linux.json              App：Linux
#   /var/www/shepaw-release/api/v1/latest-cli-macos-aarch64.json  CLI 安装脚本读
#   /var/www/shepaw-release/api/v1/latest-cli-macos-x86_64.json
#   /var/www/shepaw-release/api/v1/latest-cli-windows-x86_64.json
#   /var/www/shepaw-release/api/v1/latest-cli-linux-x86_64.json
#   /var/www/shepaw-release/download/shepaw-1.0.23-macos-release.tar.gz
#   /var/www/shepaw-release/download/shepaw-1.0.23-windows.zip
#
# 清单由 App 仓库的 tool/write_update_manifest.sh、tool/write_cli_manifests.sh
# 生成，必须带 ed25519 signature + sha256 checksum，规范见
# docs/release/MANIFEST_V2.md（App 仓库）。发布时先传安装包、最后覆盖清单。
# 本站点**不托管** /install 与 /install.ps1：那两个脚本只在 shepaw.com 主站，
# 安装命令必须写 https://shepaw.com/install（写成本站的 /install.sh 会 404）。
# 注意：以下按 Caddy v2 语法书写，本机未安装 caddy，未执行 caddy validate / caddy fmt，
# 上线前请在部署机跑一次 `caddy validate --config Caddyfile`。
# ---------------------------------------------------------------------------
release.shepaw.com {
	root * /var/www/shepaw-release

	# 全站安全头。
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# 更新清单：Content-Type 固定为 JSON，且永不缓存——yanked / 强制更新
	# 不能被浏览器或 CDN 缓存住。@manifest 同时覆盖旧版动态入口
	# /api/v1/check-update，因为 header 可能在 rewrite 之前求值。
	@manifest {
		path /api/v1/*.json /api/v1/check-update
	}
	header @manifest {
		defer
		Content-Type "application/json; charset=utf-8"
		Cache-Control "no-store"
		Pragma "no-cache"
	}

	# 旧客户端兼容：GET /api/v1/check-update?platform=macos
	#   → /api/v1/latest-macos.json
	# 用 map 做 platform 硬白名单：未知值映射到不存在的 not-allowed.json，
	# file_server 会返回 404，避免任意字符串被拼进磁盘路径。
	# 上线前请在部署机跑 `caddy validate --config Caddyfile` 确认 map 语法。
	map {query.platform} {update_manifest} {
		macos   latest-macos.json
		android latest-android.json
		ios     latest-ios.json
		windows latest-windows.json
		linux   latest-linux.json
		default not-allowed.json
	}
	@check_update path /api/v1/check-update
	rewrite @check_update /api/v1/{update_manifest}

	# /api/v1/latest-*.json 与 /download/* 都是 root 下的真实文件，file_server
	# 直接命中，无需再 rewrite。
	file_server
}
